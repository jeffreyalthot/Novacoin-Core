# novacoin.conf example
# data_dir and log_file are optional; defaults are used if absent.
#
# Windows default data_dir:
#   C:\Users\<User>\AppData\Roaming\Novacoin
# Linux/macOS default data_dir:
#   $XDG_DATA_HOME/novacoin (if XDG_DATA_HOME is set)
#   otherwise $HOME/.novacoin
#
# data_dir=/path/to/your/novacoin/data
# log_file=/path/to/your/novacoin.log
